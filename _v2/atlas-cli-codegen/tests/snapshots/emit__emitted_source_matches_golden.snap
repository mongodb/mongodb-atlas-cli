    pub(crate) fn insert(object: &mut Map<String, Value>, dotted: &str, value: Value) {
        let mut parts = dotted.split('.');
        let Some(head) = parts.next() else {
            return;
        };
        let Some(next) = parts.next() else {
            object.insert(head.to_owned(), value);
