            .read_to_string(&mut text)
            .map_err(|error| format!("cannot read request body: {error}"))?;
        let value: Value = ::serde_json::from_str(&text)
            .map_err(|error| format!("request body is not valid JSON: {error}"))?;
        validate(schema, &value)?;
