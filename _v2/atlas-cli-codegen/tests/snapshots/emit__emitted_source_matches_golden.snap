#[derive(Debug, ::clap::Subcommand)]
pub enum CliSubCommands {
    ///Manage your Atlas CLI cloud backups
    CloudBackups(CloudBackupsCommand),
    ///Cluster operations, grouped.
    Clusters(ClustersCommand),
}
impl Cli {
    pub async fn execute(self) -> ::std::result::Result<(), ::std::process::ExitCode> {
        match self.sub_command {
            CliSubCommands::CloudBackups(c) => {
                match c.sub_command {
                    CloudBackupsSubcommands::Cluster(b) => {
                        match b.sub_command {
                            CloudBackupsClusterSubcommands::Schedule(d) => {
                                match d.sub_command {
                                    CloudBackupsClusterScheduleSubcommands::Read(probe) => {
                                        probe.execute().await
                                    }
                                }
                            }
                        }
                    }
                    CloudBackupsSubcommands::CompliancePolicy(b) => {
                        match b.sub_command {
                            CloudBackupsCompliancePolicySubcommands::Read(probe) => {
                                probe.execute().await
                            }
                        }
                    }
                }
            }
            CliSubCommands::Clusters(c) => {
                match c.sub_command {
                    ClustersSubcommands::Create(probe) => probe.execute().await,
                    ClustersSubcommands::Update(probe) => probe.execute().await,
                }
            }
        }
    }
}
