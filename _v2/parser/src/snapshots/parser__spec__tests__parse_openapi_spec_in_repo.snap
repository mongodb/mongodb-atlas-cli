                            "Object": {
                              "properties": {
                                "key": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {
                                        "validation": {
                                          "Length": {
                                            "min": 1,
                                            "max": 255
                                          }
                                        }
                                      }
                                    }
                                  }
                                },
                                "value": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {
                                        "validation": {
                                          "Length": {
                                            "min": 1,
                                            "max": 255
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
