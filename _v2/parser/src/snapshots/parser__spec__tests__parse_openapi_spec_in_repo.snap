                        "String": {}
                      }
                    }
                  },
                  "expiresAt": {
                    "Optional": {
                      "data_type": {
                        "String": {}
                      }
                    }
                  },
                  "groupId": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^([a-f0-9]{24})$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "groupName": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^[\\p{L}\\p{N}\\-_.(),:&@+']{1,64}$"
