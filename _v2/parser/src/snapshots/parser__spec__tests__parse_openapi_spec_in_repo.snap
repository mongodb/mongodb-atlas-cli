    "createGroupDatabaseUser": {
      "description": "Creates one database user in the specified project. This MongoDB Cloud supports a maximum of 100 database users per project. If you require more than 100 database users on a project, contact Support.",
      "operation_id": "createGroupDatabaseUser",
      "operation_id_override": "createDatabaseUser",
      "http_verb": "POST",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies your project. Use the [/groups](#tag/Projects/operation/listProjects) endpoint to retrieve all projects to which the authenticated user has access.\n\n**NOTE**: Groups and projects are synonymous terms. Your group id is the same as your project id. For existing groups, your group/project id remains the same. The resource and corresponding endpoints use the term groups.",
              "name": "groupId",
              "required": true
            }
          },
          {
            "Const": "databaseUsers"
          }
        ],
        "query_parameters": [
          {
            "description": "Flag that indicates whether Application wraps the response in an `envelope` JSON object. Some API clients cannot access the HTTP response headers or status code. To remediate this, set envelope=true in the query. Endpoints that return a list of results use the results object as an envelope. Application adds the status parameter to the response body.",
            "name": "envelope",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          }
        ]
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2023-01-01": {
          "version": "2023-01-01",
          "request_body": {
            "Object": {
              "properties": {
                "awsIAMType": {
                  "Optional": {
                    "data_type": {
                      "Enum": [
                        "NONE",
                        "USER",
                        "ROLE"
                      ]
                    }
                  }
                },
                "databaseName": {
                  "Enum": [
                    "admin",
                    "$external"
                  ]
                },
                "deleteAfterDate": {
                  "Optional": {
                    "data_type": {
                      "String": {}
                    }
                  }
                },
                "description": {
                  "Optional": {
                    "data_type": {
                      "String": {
                        "validation": {
                          "Length": {
                            "max": 100
                          }
                        }
                      }
                    }
                  }
                },
                "groupId": {
                  "String": {}
                },
                "labels": {
                  "Optional": {
                    "data_type": {
                      "Array": {
                        "entries_type": {
                          "Object": {
                            "properties": {
                              "key": {
                                "Optional": {
                                  "data_type": {
                                    "String": {
                                      "validation": {
                                        "Length": {
                                          "min": 1,
                                          "max": 255
                                        }
                                      }
                                    }
                                  }
                                }
                              },
                              "value": {
                                "Optional": {
                                  "data_type": {
                                    "String": {
                                      "validation": {
                                        "Length": {
                                          "min": 1,
                                          "max": 255
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "ldapAuthType": {
                  "Optional": {
                    "data_type": {
                      "Enum": [
                        "NONE",
                        "GROUP",
                        "USER"
                      ]
                    }
                  }
                },
                "links": {
                  "Optional": {
                    "data_type": {
                      "Array": {
                        "entries_type": {
                          "Object": {
                            "properties": {
                              "href": {
                                "Optional": {
                                  "data_type": {
                                    "String": {}
                                  }
                                }
                              },
                              "rel": {
                                "Optional": {
                                  "data_type": {
                                    "String": {}
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "oidcAuthType": {
                  "Optional": {
                    "data_type": {
                      "Enum": [
                        "NONE",
                        "IDP_GROUP",
                        "USER"
                      ]
                    }
                  }
                },
                "password": {
                  "Optional": {
                    "data_type": {
                      "String": {
                        "validation": {
                          "Length": {
                            "min": 8
                          }
                        }
                      }
                    }
                  }
                },
                "roles": {
                  "Array": {
                    "entries_type": {
                      "Object": {
                        "properties": {
                          "collectionName": {
                            "Optional": {
                              "data_type": {
                                "String": {}
                              }
                            }
                          },
                          "databaseName": {
                            "String": {}
                          },
                          "roleName": {
                            "Enum": [
                              "atlasAdmin",
                              "backup",
                              "clusterMonitor",
                              "dbAdmin",
                              "dbAdminAnyDatabase",
                              "enableSharding",
                              "read",
                              "readAnyDatabase",
                              "readWrite",
                              "readWriteAnyDatabase",
                              "<a custom role name>"
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                "scopes": {
                  "Optional": {
                    "data_type": {
                      "Array": {
                        "entries_type": {
                          "Object": {
                            "properties": {
                              "name": {
                                "String": {
                                  "validation": {
                                    "Regex": {
                                      "regex": "^[a-zA-Z0-9][a-zA-Z0-9-]*$"
                                    }
                                  }
                                }
                              },
                              "type": {
                                "Enum": [
                                  "CLUSTER",
                                  "DATA_LAKE",
                                  "STREAM"
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "username": {
                  "String": {
                    "validation": {
                      "Length": {
                        "max": 1024
                      }
                    }
                  }
                },
                "x509Type": {
                  "Optional": {
                    "data_type": {
                      "Enum": [
                        "NONE",
                        "CUSTOMER",
                        "MANAGED"
                      ]
                    }
                  }
                }
              }
            }
          },
          "response_bodies": {
            "json": {
              "Object": {
                "properties": {
