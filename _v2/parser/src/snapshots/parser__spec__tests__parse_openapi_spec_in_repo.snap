    "getSystemStatus": {
      "description": "This resource returns information about the MongoDB application along with API key meta data.",
      "operation_id": "getSystemStatus",
      "http_verb": "GET",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          }
        ],
        "query_parameters": [
          {
            "description": "Flag that indicates whether Application wraps the response in an `envelope` JSON object. Some API clients cannot access the HTTP response headers or status code. To remediate this, set envelope=true in the query. Endpoints that return a list of results use the results object as an envelope. Application adds the status parameter to the response body.",
            "name": "envelope",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          }
        ]
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2023-01-01": {
          "version": "2023-01-01",
          "response_bodies": {
            "json": {
              "Object": {
                "properties": {
                  "apiKey": {
                    "Optional": {
                      "data_type": {
                        "Object": {
                          "properties": {
                            "accessList": {
                              "Array": {
                                "entries_type": {
                                  "Object": {
                                    "properties": {
                                      "cidrBlock": {
                                        "Optional": {
                                          "data_type": {
                                            "String": {
                                              "validation": {
                                                "Regex": {
                                                  "regex": "^((([0-9]{1,3}\\.){3}[0-9]{1,3})|(:{0,2}([0-9a-f]{1,4}:){0,7}[0-9a-f]{1,4}[:]{0,2}))((%2[fF]|/)[0-9]{1,3})+$"
                                                }
                                              }
                                            }
                                          }
                                        }
                                      },
                                      "ipAddress": {
                                        "Optional": {
                                          "data_type": {
                                            "String": {
                                              "validation": {
                                                "Regex": {
                                                  "regex": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)(\\.(?!$)|$)){4}|([0-9a-f]{1,4}:){7}[0-9a-f]{1,4}$"
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            },
                            "id": {
                              "String": {
                                "validation": {
                                  "Regex": {
                                    "regex": "^([a-f0-9]{24})$"
                                  }
                                }
                              }
                            },
                            "publicKey": {
                              "String": {
                                "validation": {
                                  "Length": {
                                    "min": 8,
                                    "max": 8
                                  }
                                }
                              }
                            },
                            "roles": {
                              "Array": {
                                "entries_type": {
                                  "Object": {
                                    "properties": {
                                      "groupId": {
                                        "Optional": {
                                          "data_type": {
                                            "String": {
                                              "validation": {
                                                "Regex": {
                                                  "regex": "^([a-f0-9]{24})$"
                                                }
                                              }
                                            }
                                          }
                                        }
                                      },
                                      "orgId": {
                                        "Optional": {
                                          "data_type": {
                                            "String": {
                                              "validation": {
                                                "Regex": {
                                                  "regex": "^([a-f0-9]{24})$"
                                                }
                                              }
                                            }
                                          }
                                        }
                                      },
                                      "roleName": {
                                        "Optional": {
                                          "data_type": {
                                            "String": {}
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "appName": {
                    "Enum": [
                      "MongoDB Atlas"
                    ]
                  },
                  "build": {
                    "String": {}
                  },
                  "links": {
                    "Optional": {
                      "data_type": {
                        "Array": {
                          "entries_type": {
                            "Object": {
                              "properties": {
                                "href": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "rel": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "throttling": {
                    "Boolean": {}
                  }
                }
              }
            }
          }
        }
