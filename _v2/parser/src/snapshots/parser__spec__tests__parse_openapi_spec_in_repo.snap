    "updateOrgApiKey": {
      "description": "Updates one organization API key in the specified organization. The organization API keys  grant programmatic access to an organization.",
      "operation_id": "updateOrgApiKey",
      "http_verb": "PATCH",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "orgs"
