    "createGroupClusterIndexRollingIndex": {
      "description": "Creates an index on the cluster identified by its name in a rolling manner. Creating the index in this way allows index builds on one replica set member as a standalone at a time, starting with the secondary members. Creating indexes in this way requires at least one replica set election.",
      "operation_id": "createGroupClusterIndexRollingIndex",
      "operation_id_override": "createRollingIndex",
      "http_verb": "POST",
      "url": {
        "parts": [
          {
            "Const": "api"
