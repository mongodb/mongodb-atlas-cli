          "version": "2023-01-01",
          "request_body": {
            "Object": {
              "properties": {
                "desc": {
                  "Optional": {
                    "data_type": {
                      "String": {
                        "validation": {
                          "Length": {
                            "min": 1,
                            "max": 250
                          }
                        }
                      }
                    }
                  }
                },
                "roles": {
                  "Optional": {
                    "data_type": {
                      "Array": {
                        "entries_type": {
                          "Optional": {
                            "data_type": {
                              "Enum": [
                                "ORG_OWNER",
