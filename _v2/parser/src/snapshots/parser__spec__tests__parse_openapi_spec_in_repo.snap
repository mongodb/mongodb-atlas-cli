    "createGroupContainer": {
      "description": "Creates one new network peering container in the specified project. MongoDB Cloud can deploy Network Peering connections in a network peering container. GCP can have one container per project. AWS and Azure can have one container per cloud provider region.",
      "operation_id": "createGroupContainer",
      "http_verb": "POST",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies your project. Use the [/groups](#tag/Projects/operation/listProjects) endpoint to retrieve all projects to which the authenticated user has access.\n\n**NOTE**: Groups and projects are synonymous terms. Your group id is the same as your project id. For existing groups, your group/project id remains the same. The resource and corresponding endpoints use the term groups.",
              "name": "groupId",
              "required": true
            }
          },
          {
            "Const": "containers"
          }
        ],
        "query_parameters": [
          {
            "description": "Flag that indicates whether Application wraps the response in an `envelope` JSON object. Some API clients cannot access the HTTP response headers or status code. To remediate this, set envelope=true in the query. Endpoints that return a list of results use the results object as an envelope. Application adds the status parameter to the response body.",
            "name": "envelope",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          }
        ]
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2023-01-01": {
          "version": "2023-01-01",
          "request_body": {
            "OneOf": {
              "discriminator_field": "providerName",
              "options": {
                "AWS": {
                  "Object": {
                    "properties": {
                      "atlasCidrBlock": {
                        "Optional": {
                          "data_type": {
                            "String": {
                              "validation": {
                                "Regex": {
                                  "regex": "^((([0-9]{1,3}\\.){3}[0-9]{1,3})|(:{0,2}([0-9a-f]{1,4}:){0,7}[0-9a-f]{1,4}[:]{0,2}))((%2[fF]|/)[0-9]{1,3})+$"
                                }
                              }
                            }
                          }
                        }
                      },
                      "id": {
                        "Optional": {
                          "data_type": {
                            "String": {
                              "validation": {
                                "Regex": {
                                  "regex": "^([a-f0-9]{24})$"
                                }
                              }
                            }
                          }
                        }
                      },
                      "provisioned": {
                        "Optional": {
                          "data_type": {
                            "Boolean": {}
                          }
                        }
                      },
                      "regionName": {
                        "Optional": {
                          "data_type": {
                            "Enum": [
                              "US_EAST_1",
                              "US_EAST_2",
                              "US_WEST_1",
                              "US_WEST_2",
                              "CA_CENTRAL_1",
                              "EU_NORTH_1",
                              "EU_WEST_1",
                              "EU_WEST_2",
                              "EU_WEST_3",
                              "EU_CENTRAL_1",
                              "EU_CENTRAL_2",
                              "SA_EAST_1",
                              "AP_EAST_1",
                              "AP_EAST_2",
                              "AP_SOUTHEAST_2",
                              "AP_SOUTHEAST_3",
                              "AP_SOUTHEAST_4",
                              "AP_SOUTHEAST_5",
                              "AP_SOUTHEAST_6",
                              "AP_SOUTHEAST_7",
                              "AP_NORTHEAST_1",
                              "AP_NORTHEAST_2",
                              "AP_NORTHEAST_3",
                              "AP_SOUTHEAST_1",
                              "AP_SOUTH_1",
                              "AP_SOUTH_2",
                              "CN_NORTH_1",
                              "CN_NORTHWEST_1",
                              "ME_CENTRAL_1",
                              "ME_SOUTH_1",
                              "AF_SOUTH_1",
                              "EU_SOUTH_1",
                              "EU_SOUTH_2",
                              "IL_CENTRAL_1",
                              "CA_WEST_1",
                              "MX_CENTRAL_1",
                              "GLOBAL",
                              "US_GOV_WEST_1",
                              "US_GOV_EAST_1"
                            ]
                          }
                        }
                      },
                      "vpcId": {
                        "Optional": {
                          "data_type": {
                            "String": {
                              "validation": {
                                "Regex": {
                                  "regex": "^vpc-[0-9a-f]{17}$"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "AZURE": {
                  "Object": {
                    "properties": {
                      "atlasCidrBlock": {
                        "Optional": {
                          "data_type": {
                            "String": {
                              "validation": {
                                "Regex": {
                                  "regex": "^((([0-9]{1,3}\\.){3}[0-9]{1,3})|(:{0,2}([0-9a-f]{1,4}:){0,7}[0-9a-f]{1,4}[:]{0,2}))((%2[fF]|/)[0-9]{1,3})+$"
                                }
                              }
                            }
                          }
                        }
                      },
                      "azureSubscriptionId": {
                        "Optional": {
                          "data_type": {
                            "String": {
                              "validation": {
                                "Regex": {
                                  "regex": "^([a-f0-9]{24})$"
                                }
                              }
                            }
