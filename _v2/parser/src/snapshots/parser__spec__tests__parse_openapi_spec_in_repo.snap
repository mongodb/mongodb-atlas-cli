    "getOrgApiKeyAccessListEntry": {
      "description": "Returns one access list entry for the specified organization API key. Resources require  all API requests originate from IP addresses on the API access list.",
      "operation_id": "getOrgApiKeyAccessListEntry",
      "operation_id_override": "getOrgAccessEntry",
      "http_verb": "GET",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "orgs"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies the organization that contains your projects. Use the [`/orgs`](#tag/Organizations/operation/listOrganizations) endpoint to retrieve all organizations to which the authenticated user has access.",
              "name": "orgId",
              "required": true
            }
          },
          {
            "Const": "apiKeys"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies this organization API key for  which you want to return access list entries.",
              "name": "apiUserId",
              "required": true
            }
          },
          {
            "Const": "accessList"
          },
          {
            "Parameter": {
              "description": "One IP address or multiple IP addresses represented as one CIDR block to limit  requests to API resources in the specified organization. When adding a CIDR block with a subnet mask, such as  192.0.2.0/24, use the URL-encoded value %2F for the forward slash /.",
              "name": "ipAddress",
              "required": true
            }
          }
        ],
        "query_parameters": [
          {
            "description": "Flag that indicates whether Application wraps the response in an `envelope` JSON object. Some API clients cannot access the HTTP response headers or status code. To remediate this, set envelope=true in the query. Endpoints that return a list of results use the results object as an envelope. Application adds the status parameter to the response body.",
            "name": "envelope",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          }
        ]
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2023-01-01": {
          "version": "2023-01-01",
          "response_bodies": {
            "json": {
              "Object": {
                "properties": {
                  "cidrBlock": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^((([0-9]{1,3}\\.){3}[0-9]{1,3})|(:{0,2}([0-9a-f]{1,4}:){0,7}[0-9a-f]{1,4}[:]{0,2}))((%2[fF]|/)[0-9]{1,3})+$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "count": {
                    "Optional": {
                      "data_type": {
                        "Integer": {}
                      }
                    }
                  },
                  "created": {
                    "Optional": {
                      "data_type": {
                        "String": {}
                      }
                    }
                  },
                  "ipAddress": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)(\\.(?!$)|$)){4}|([0-9a-f]{1,4}:){7}[0-9a-f]{1,4}$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "lastUsed": {
                    "Optional": {
                      "data_type": {
                        "String": {}
                      }
                    }
                  },
                  "lastUsedAddress": {
                    "Optional": {
                      "data_type": {
                        "String": {}
                      }
                    }
                  },
                  "links": {
                    "Optional": {
                      "data_type": {
                        "Array": {
                          "entries_type": {
                            "Object": {
                              "properties": {
                                "href": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "rel": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
