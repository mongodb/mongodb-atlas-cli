                                              "timestamp": {
                                                "Optional": {
                                                  "data_type": {
                                                    "String": {}
                                                  }
                                                }
                                              },
                                              "value": {
                                                "Optional": {
                                                  "data_type": {
                                                    "Double": {}
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                },
                                "name": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "units": {
                                  "Optional": {
                                    "data_type": {
                                      "Enum": [
                                        "BYTES",
                                        "BYTES_PER_SECOND",
                                        "GIGABYTES",
                                        "GIGABYTES_PER_HOUR",
                                        "MEGABYTES_PER_SECOND",
                                        "MICROSECONDS",
                                        "MILLISECONDS",
                                        "PERCENT",
                                        "SCALAR",
                                        "SCALAR_PER_SECOND"
                                      ]
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "processId": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^([0-9]{1,3}\\.){3}[0-9]{1,3}|([0-9a-f]{1,4}\\:){7}([0-9a-f]{1,4})|(([a-z0-9]+\\.){1,10}[a-z]+)?(\\:[0-9]{4,5})$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "start": {
                    "Optional": {
                      "data_type": {
                        "String": {}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "listGroupProcessDatabases": {
      "description": "Returns the list of databases running on the specified host for the specified project. `M0` free clusters, `M2`, `M5`, serverless, and Flex clusters have some operational limits. The MongoDB Cloud process must be a `mongod`.",
      "operation_id": "listGroupProcessDatabases",
      "operation_id_override": "listDatabases",
      "http_verb": "GET",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies your project. Use the [/groups](#tag/Projects/operation/listProjects) endpoint to retrieve all projects to which the authenticated user has access.\n\n**NOTE**: Groups and projects are synonymous terms. Your group id is the same as your project id. For existing groups, your group/project id remains the same. The resource and corresponding endpoints use the term groups.",
              "name": "groupId",
              "required": true
            }
          },
          {
            "Const": "processes"
          },
          {
            "Parameter": {
              "description": "Combination of hostname and Internet Assigned Numbers Authority (IANA) port that serves the MongoDB process. The host must be the hostname, fully qualified domain name (FQDN), or Internet Protocol address (IPv4 or IPv6) of the host that runs the MongoDB process (`mongod`). The port must be the IANA port on which the MongoDB process listens for requests.",
              "name": "processId",
              "required": true
            }
          },
          {
            "Const": "databases"
          }
        ],
        "query_parameters": [
          {
            "description": "Flag that indicates whether Application wraps the response in an `envelope` JSON object. Some API clients cannot access the HTTP response headers or status code. To remediate this, set envelope=true in the query. Endpoints that return a list of results use the results object as an envelope. Application adds the status parameter to the response body.",
            "name": "envelope",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response returns the total number of items (`totalCount`) in the response.",
            "name": "includeCount",
            "required": false
          },
          {
            "description": "Number of items that the response returns per page.",
            "name": "itemsPerPage",
            "required": false
          },
          {
            "description": "Number of the page that displays the current set of the total objects that the response returns.",
            "name": "pageNum",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          }
        ]
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2023-01-01": {
          "version": "2023-01-01",
