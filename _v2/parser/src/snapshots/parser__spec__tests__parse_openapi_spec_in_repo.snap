    "deleteGroupLimit": {
      "description": "Removes the specified project limit. Depending on the limit, Atlas either resets the limit to its default value or removes the limit entirely.",
      "operation_id": "deleteGroupLimit",
      "http_verb": "DELETE",
      "url": {
        "parts": [
          {
            "Const": "api"
