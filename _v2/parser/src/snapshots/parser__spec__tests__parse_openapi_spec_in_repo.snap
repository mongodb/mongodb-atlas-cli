    "getGroupDbAccessHistoryCluster": {
      "description": "Returns the access logs of one cluster identified by the cluster's name. Access logs contain a list of authentication requests made against your cluster. You can't use this feature on tenant-tier clusters (M0, M2, M5).",
      "operation_id": "getGroupDbAccessHistoryCluster",
      "operation_id_override": "getAccessHistoryCluster",
      "http_verb": "GET",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies your project. Use the [/groups](#tag/Projects/operation/listProjects) endpoint to retrieve all projects to which the authenticated user has access.\n\n**NOTE**: Groups and projects are synonymous terms. Your group id is the same as your project id. For existing groups, your group/project id remains the same. The resource and corresponding endpoints use the term groups.",
              "name": "groupId",
              "required": true
            }
          },
          {
            "Const": "dbAccessHistory"
          },
          {
            "Const": "clusters"
          },
          {
            "Parameter": {
              "description": "Human-readable label that identifies the cluster.",
              "name": "clusterName",
              "required": true
            }
          }
        ],
        "query_parameters": [
          {
            "description": "Flag that indicates whether Application wraps the response in an `envelope` JSON object. Some API clients cannot access the HTTP response headers or status code. To remediate this, set envelope=true in the query. Endpoints that return a list of results use the results object as an envelope. Application adds the status parameter to the response body.",
            "name": "envelope",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response returns the successful authentication attempts only.",
            "name": "authResult",
            "required": false
          },
          {
            "description": "Date and time when to stop retrieving database history. If you specify **end**, you must also specify **start**. This parameter uses UNIX epoch time in milliseconds.",
            "name": "end",
            "required": false
          },
          {
            "description": "One Internet Protocol address that attempted to authenticate with the database.",
            "name": "ipAddress",
            "required": false
          },
          {
            "description": "Maximum number of lines from the log to return.",
            "name": "nLogs",
            "required": false
          },
          {
            "description": "Date and time when MongoDB Cloud begins retrieving database history. If you specify **start**, you must also specify **end**. This parameter uses UNIX epoch time in milliseconds.",
            "name": "start",
            "required": false
          }
        ]
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2023-01-01": {
          "version": "2023-01-01",
          "response_bodies": {
            "json": {
              "Object": {
                "properties": {
                  "accessLogs": {
                    "Optional": {
                      "data_type": {
                        "Array": {
                          "entries_type": {
                            "Object": {
                              "properties": {
                                "authResult": {
                                  "Optional": {
                                    "data_type": {
                                      "Boolean": {}
                                    }
                                  }
                                },
                                "authSource": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "failureReason": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "groupId": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "hostname": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "ipAddress": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {
                                        "validation": {
                                          "Regex": {
                                            "regex": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)(\\.(?!$)|$)){4}|([0-9a-f]{1,4}:){7}[0-9a-f]{1,4}$"
                                          }
                                        }
                                      }
                                    }
                                  }
                                },
                                "logLine": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "timestamp": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "username": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
