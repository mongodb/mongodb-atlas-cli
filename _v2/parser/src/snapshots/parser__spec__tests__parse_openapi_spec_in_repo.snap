                  },
                  "description": {
                    "Optional": {
                      "data_type": {
                        "String": {}
                      }
                    }
                  },
                  "maximumLimit": {
                    "Optional": {
                      "data_type": {
                        "Integer": {}
                      }
                    }
                  },
                  "name": {
                    "Optional": {
                      "data_type": {
                        "String": {}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
