              "name": "orgId",
              "required": true
            }
          },
          {
            "Const": "teams"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal character string that identifies the team to which you want to add MongoDB Cloud users.",
              "name": "teamId",
              "required": true
