    "updateGroupClusterQueryShape": {
      "description": "Updates the rejection status of a query shape. Use this endpoint to reject a query shape (preventing it from executing on the cluster) or to unreject a previously rejected query shape (allowing it to execute again). This operation is idempotent: rejecting an already rejected query shape or unrejecting an already unrejected query shape will return 200 OK.",
      "operation_id": "updateGroupClusterQueryShape",
      "operation_id_override": "updateClusterQueryShape",
      "http_verb": "PATCH",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies your project. Use the [/groups](#tag/Projects/operation/listProjects) endpoint to retrieve all projects to which the authenticated user has access.\n\n**NOTE**: Groups and projects are synonymous terms. Your group id is the same as your project id. For existing groups, your group/project id remains the same. The resource and corresponding endpoints use the term groups.",
              "name": "groupId",
              "required": true
            }
          },
          {
            "Const": "clusters"
          },
          {
            "Parameter": {
              "description": "Human-readable label that identifies the cluster.",
              "name": "clusterName",
              "required": true
            }
          },
          {
            "Const": "queryShapes"
          },
          {
            "Parameter": {
              "description": "A SHA256 hash of a query shape, output by MongoDB commands like `$queryStats` and `$explain` or slow query logs.",
              "name": "queryShapeHash",
              "required": true
            }
          }
        ],
        "query_parameters": [
          {
            "description": "Flag that indicates whether Application wraps the response in an `envelope` JSON object. Some API clients cannot access the HTTP response headers or status code. To remediate this, set envelope=true in the query. Endpoints that return a list of results use the results object as an envelope. Application adds the status parameter to the response body.",
            "name": "envelope",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          }
        ]
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2025-03-12": {
          "version": "2025-03-12",
          "request_body": {
            "Object": {
              "properties": {
                "status": {
                  "Enum": [
                    "REJECTED",
                    "UNREJECTED"
                  ]
                }
              }
            }
          },
          "response_bodies": {
            "json": {
              "Object": {
                "properties": {
                  "command": {
                    "Optional": {
                      "data_type": {
                        "Enum": [
                          "FIND",
                          "DISTINCT",
                          "AGGREGATE"
                        ]
                      }
                    }
                  },
                  "namespace": {
                    "Optional": {
                      "data_type": {
                        "String": {}
                      }
                    }
                  },
                  "queryShape": {
                    "Optional": {
                      "data_type": {
                        "String": {}
                      }
                    }
                  },
                  "queryShapeHash": {
                    "String": {}
                  },
                  "status": {
                    "Enum": [
                      "REJECTED",
                      "UNREJECTED"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "updateGroupClusterSearchDeployment": {
