    "deleteGroupClusterSnapshot": {
      "description": "Removes one legacy backup snapshot for one cluster in the specified project. Effective 23 March 2020, all new clusters can use only Cloud Backups. When you upgrade to 4.2, your backup system upgrades to cloud backup if it is currently set to legacy backup. After this upgrade, all your existing legacy backup snapshots remain available. They expire over time in accordance with your retention policy. Your backup policy resets to the default schedule. If you had a custom backup policy in place with legacy backups, you must re-create it with the procedure outlined in the Cloud Backup documentation.",
      "operation_id": "deleteGroupClusterSnapshot",
      "operation_id_override": "deleteClusterSnapshot",
      "http_verb": "DELETE",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
