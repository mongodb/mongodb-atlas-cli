              "name": "groupId",
              "required": true
            }
          },
          {
            "Const": "alerts"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies the alert.",
              "name": "alertId",
              "required": true
            }
          }
