    "createGroupMcpConfig": {
      "description": "Creates an MCP configuration for the specified project. Returns the configuration ID and ingress credentials.",
      "operation_id": "createGroupMcpConfig",
      "http_verb": "POST",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies your project. Use the [/groups](#tag/Projects/operation/listProjects) endpoint to retrieve all projects to which the authenticated user has access.\n\n**NOTE**: Groups and projects are synonymous terms. Your group id is the same as your project id. For existing groups, your group/project id remains the same. The resource and corresponding endpoints use the term groups.",
              "name": "groupId",
              "required": true
            }
          },
          {
            "Const": "mcpConfigs"
          }
        ],
        "query_parameters": []
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2025-03-12": {
          "version": "2025-03-12",
          "request_body": {
            "Object": {
              "properties": {
                "ipAccessList": {
                  "Optional": {
                    "data_type": {
                      "Array": {
                        "entries_type": {
                          "Object": {
                            "properties": {
                              "cidrBlock": {
                                "Optional": {
                                  "data_type": {
                                    "String": {
                                      "validation": {
                                        "Regex": {
                                          "regex": "^((([0-9]{1,3}\\.){3}[0-9]{1,3})|(:{0,2}([0-9a-f]{1,4}:){0,7}[0-9a-f]{1,4}[:]{0,2}))((%2[fF]|/)[0-9]{1,3})+$"
                                        }
                                      }
                                    }
                                  }
                                }
                              },
                              "createdAt": {
                                "Optional": {
                                  "data_type": {
                                    "String": {}
                                  }
                                }
                              },
                              "ipAddress": {
                                "Optional": {
                                  "data_type": {
                                    "String": {
                                      "validation": {
                                        "Regex": {
                                          "regex": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)(\\.(?!$)|$)){4}|([0-9a-f]{1,4}:){7}[0-9a-f]{1,4}$"
                                        }
                                      }
                                    }
                                  }
                                }
                              },
                              "lastUsedAddress": {
                                "Optional": {
                                  "data_type": {
                                    "String": {}
                                  }
                                }
                              },
                              "lastUsedAt": {
                                "Optional": {
                                  "data_type": {
                                    "String": {}
                                  }
                                }
                              },
                              "requestCount": {
                                "Optional": {
                                  "data_type": {
                                    "Integer": {}
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "mcpConfigName": {
                  "String": {
                    "validation": {
                      "Length": {
                        "min": 1
                      }
                    }
                  }
                },
                "roles": {
                  "Array": {
                    "entries_type": {
                      "String": {}
                    }
                  }
                }
              }
            }
          },
          "response_bodies": {
            "json": {
              "Object": {
                "properties": {
                  "clientId": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
