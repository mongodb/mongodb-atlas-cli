      "operation_id": "getOrgMcpConfig",
      "http_verb": "GET",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "orgs"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies the organization that contains your projects. Use the [`/orgs`](#tag/Organizations/operation/listOrganizations) endpoint to retrieve all organizations to which the authenticated user has access.",
              "name": "orgId",
              "required": true
            }
          },
          {
            "Const": "mcpConfigs"
          },
          {
            "Parameter": {
              "description": "Unique identifier of the MCP configuration.",
              "name": "mcpConfigId",
              "required": true
            }
          }
        ],
        "query_parameters": [
          {
            "description": "Flag that indicates whether Application wraps the response in an `envelope` JSON object. Some API clients cannot access the HTTP response headers or status code. To remediate this, set envelope=true in the query. Endpoints that return a list of results use the results object as an envelope. Application adds the status parameter to the response body.",
            "name": "envelope",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          }
        ]
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2025-03-12": {
          "version": "2025-03-12",
          "response_bodies": {
            "json": {
              "Object": {
                "properties": {
                  "clientId": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^mdb_sa_id_[a-fA-F\\d]{24}$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "egressClientId": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^mdb_sa_id_[a-fA-F\\d]{24}$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "ipAccessList": {
                    "Optional": {
                      "data_type": {
                        "Array": {
                          "entries_type": {
                            "Object": {
                              "properties": {
                                "cidrBlock": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {
                                        "validation": {
                                          "Regex": {
                                            "regex": "^((([0-9]{1,3}\\.){3}[0-9]{1,3})|(:{0,2}([0-9a-f]{1,4}:){0,7}[0-9a-f]{1,4}[:]{0,2}))((%2[fF]|/)[0-9]{1,3})+$"
                                          }
                                        }
                                      }
                                    }
                                  }
                                },
                                "createdAt": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "ipAddress": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {
                                        "validation": {
                                          "Regex": {
                                            "regex": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)(\\.(?!$)|$)){4}|([0-9a-f]{1,4}:){7}[0-9a-f]{1,4}$"
                                          }
                                        }
                                      }
                                    }
                                  }
                                },
                                "lastUsedAddress": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "lastUsedAt": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "requestCount": {
                                  "Optional": {
                                    "data_type": {
                                      "Integer": {}
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "mcpConfigId": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "mcpConfigName": {
                    "Optional": {
                      "data_type": {
                        "String": {}
                      }
                    }
                  },
                  "roles": {
                    "Optional": {
                      "data_type": {
                        "Array": {
                          "entries_type": {
                            "Enum": [
                              "ORG_MEMBER",
                              "ORG_READ_ONLY",
                              "ORG_BILLING_ADMIN",
                              "ORG_BILLING_READ_ONLY",
                              "ORG_STREAM_PROCESSING_ADMIN",
                              "ORG_GROUP_CREATOR",
                              "ORG_OWNER"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
