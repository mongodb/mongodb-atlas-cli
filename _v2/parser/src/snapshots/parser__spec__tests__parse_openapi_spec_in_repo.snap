    "getGroup": {
      "description": "Returns details about the specified project. Projects group clusters into logical collections that support an application environment, workload, or both. Each project can have its own users, teams, security, tags, and alert settings.",
      "operation_id": "getGroup",
      "http_verb": "GET",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies your project. Use the [/groups](#tag/Projects/operation/listProjects) endpoint to retrieve all projects to which the authenticated user has access.\n\n**NOTE**: Groups and projects are synonymous terms. Your group id is the same as your project id. For existing groups, your group/project id remains the same. The resource and corresponding endpoints use the term groups.",
              "name": "groupId",
              "required": true
            }
          }
        ],
        "query_parameters": [
          {
            "description": "Flag that indicates whether Application wraps the response in an `envelope` JSON object. Some API clients cannot access the HTTP response headers or status code. To remediate this, set envelope=true in the query. Endpoints that return a list of results use the results object as an envelope. Application adds the status parameter to the response body.",
            "name": "envelope",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          }
        ]
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2023-01-01": {
          "version": "2023-01-01",
          "response_bodies": {
            "json": {
              "Object": {
                "properties": {
                  "clusterCount": {
                    "Integer": {}
                  },
                  "created": {
                    "String": {}
                  },
                  "id": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^([a-f0-9]{24})$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "links": {
                    "Optional": {
                      "data_type": {
                        "Array": {
                          "entries_type": {
                            "Object": {
                              "properties": {
                                "href": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "rel": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "name": {
                    "String": {
                      "validation": {
                        "Regex": {
                          "regex": "^[\\p{L}\\p{N}\\-_.(),:&@+']{1,64}$"
                        }
                      }
                    }
                  },
                  "orgId": {
                    "String": {
                      "validation": {
                        "Regex": {
                          "regex": "^([a-f0-9]{24})$"
                        }
                      }
                    }
                  },
                  "regionUsageRestrictions": {
                    "Optional": {
                      "data_type": {
                        "Enum": [
                          "COMMERCIAL_FEDRAMP_REGIONS_ONLY",
                          "GOV_REGIONS_ONLY"
                        ]
                      }
                    }
                  },
                  "tags": {
                    "Optional": {
                      "data_type": {
                        "Array": {
                          "entries_type": {
                            "Object": {
                              "properties": {
                                "key": {
                                  "String": {
                                    "validation": {
                                      "Length": {
                                        "min": 1,
                                        "max": 255
                                      }
                                    }
                                  }
                                },
                                "value": {
                                  "String": {
                                    "validation": {
                                      "Length": {
                                        "min": 1,
                                        "max": 255
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "withDefaultAlertsSettings": {
                    "Optional": {
                      "data_type": {
                        "Boolean": {}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "getGroupAccessListEntry": {
      "description": "Returns one access list entry from the specified project's IP access list. Each entry in the project's IP access list contains either one IP address or one CIDR-notated block of IP addresses. MongoDB Cloud only allows client connections to the cluster from entries in the project's IP access list. This resource replaces the whitelist resource. MongoDB Cloud removed whitelists in July 2021. Update your applications to use this new resource. This endpoint (`/groups/{GROUP-ID}/accessList`) manages the Project IP Access List. It doesn't manage the access list for MongoDB Cloud organizations. The Programmatic API Keys endpoint (`/orgs/{ORG-ID}/apiKeys/{API-KEY-ID}/accesslist`) manages those access lists.",
      "operation_id": "getGroupAccessListEntry",
      "operation_id_override": "getAccessListEntry",
      "http_verb": "GET",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies your project. Use the [/groups](#tag/Projects/operation/listProjects) endpoint to retrieve all projects to which the authenticated user has access.\n\n**NOTE**: Groups and projects are synonymous terms. Your group id is the same as your project id. For existing groups, your group/project id remains the same. The resource and corresponding endpoints use the term groups.",
              "name": "groupId",
              "required": true
            }
          },
          {
            "Const": "accessList"
          },
          {
            "Parameter": {
              "description": "Access list entry that you want to return from the project's IP access list. This value can use one of the following: one AWS security group ID, one IP address, or one CIDR block of addresses. For CIDR blocks that use a subnet mask, replace the forward slash (`/`) with its URL-encoded value (`%2F`).",
              "name": "entryValue",
              "required": true
            }
          }
        ],
        "query_parameters": [
          {
            "description": "Flag that indicates whether Application wraps the response in an `envelope` JSON object. Some API clients cannot access the HTTP response headers or status code. To remediate this, set envelope=true in the query. Endpoints that return a list of results use the results object as an envelope. Application adds the status parameter to the response body.",
            "name": "envelope",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          }
        ]
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2023-01-01": {
          "version": "2023-01-01",
          "response_bodies": {
            "json": {
              "Object": {
                "properties": {
                  "awsSecurityGroup": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^([0-9]*/)?sg-([0-9]*)"
                            }
                          }
                        }
                      }
                    }
                  },
                  "cidrBlock": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^([0-9]{1,3}\\.){3}[0-9]{1,3}(%2[fF][0-9]{1,3})?|([0-9a-f]{1,4}\\:){7}[0-9a-f]{1,4}(%2[fF][0-9]{1,3})?|([0-9a-f]{1,4}\\:){1,6}\\:(%2[fF][0-9]{1,3})?$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "comment": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Length": {
                              "max": 80
                            }
                          }
                        }
                      }
                    }
                  },
                  "deleteAfterDate": {
                    "Optional": {
                      "data_type": {
                        "String": {}
                      }
                    }
                  },
                  "groupId": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^([a-f0-9]{24})$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "ipAddress": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)(\\.(?!$)|$)){4}|([0-9a-f]{1,4}:){7}[0-9a-f]{1,4}$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "links": {
                    "Optional": {
                      "data_type": {
                        "Array": {
                          "entries_type": {
                            "Object": {
                              "properties": {
                                "href": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "rel": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
