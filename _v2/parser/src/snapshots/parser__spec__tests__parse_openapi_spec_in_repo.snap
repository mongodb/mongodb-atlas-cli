    "updateGroupInviteById": {
      "description": "Updates the details of one pending invitation to the specified project. To specify which invitation to update, provide the unique identification string for that invitation. Use the Return All Project Invitations endpoint to retrieve IDs for all pending project invitations.",
      "operation_id": "updateGroupInviteById",
      "operation_id_override": "updateInviteById",
      "http_verb": "PATCH",
