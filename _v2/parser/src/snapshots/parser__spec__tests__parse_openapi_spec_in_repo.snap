    "listGroupProcessCollStatMeasurements": {
      "description": "Get a list of the Coll Stats Latency process-level measurements for the given namespace.",
      "operation_id": "listGroupProcessCollStatMeasurements",
      "operation_id_override": "listProcessMeasurements",
      "http_verb": "GET",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
