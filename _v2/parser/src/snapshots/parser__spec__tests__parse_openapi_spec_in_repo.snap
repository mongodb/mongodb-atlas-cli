                        "Enum": [
                          "NONE",
                          "CUSTOMER",
                          "MANAGED"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "createGroupDatabaseUserCert": {
      "description": "Generates one X.509 certificate for the specified MongoDB user. Atlas manages the            certificate and MongoDB user that belong to one project.\n\n\nTo get MongoDB Cloud to generate a managed certificate for a database user, set `\"x509Type\" : \"MANAGED\"` on the desired MongoDB Database User.\n\nIf you are managing your own Certificate Authority (CA) in Self-Managed X.509 mode, you must generate certificates for database users using your own CA.",
      "operation_id": "createGroupDatabaseUserCert",
      "operation_id_override": "createDatabaseUserCert",
      "http_verb": "POST",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies your project. Use the [/groups](#tag/Projects/operation/listProjects) endpoint to retrieve all projects to which the authenticated user has access.\n\n**NOTE**: Groups and projects are synonymous terms. Your group id is the same as your project id. For existing groups, your group/project id remains the same. The resource and corresponding endpoints use the term groups.",
              "name": "groupId",
              "required": true
            }
          },
          {
            "Const": "databaseUsers"
          },
          {
            "Parameter": {
              "description": "Human-readable label that represents the MongoDB database user account for whom to create a certificate.",
              "name": "username",
              "required": true
            }
          },
          {
            "Const": "certs"
          }
        ],
        "query_parameters": [
          {
            "description": "Flag that indicates whether Application wraps the response in an `envelope` JSON object. Some API clients cannot access the HTTP response headers or status code. To remediate this, set envelope=true in the query. Endpoints that return a list of results use the results object as an envelope. Application adds the status parameter to the response body.",
            "name": "envelope",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          }
        ]
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2023-01-01": {
          "version": "2023-01-01",
          "request_body": {
            "Object": {
              "properties": {
                "_id": {
                  "Optional": {
                    "data_type": {
                      "Integer": {}
                    }
                  }
                },
                "createdAt": {
                  "Optional": {
                    "data_type": {
                      "String": {}
                    }
                  }
                },
                "groupId": {
                  "Optional": {
                    "data_type": {
                      "String": {
                        "validation": {
                          "Regex": {
                            "regex": "^([a-f0-9]{24})$"
                          }
                        }
                      }
                    }
                  }
                },
                "links": {
                  "Optional": {
                    "data_type": {
                      "Array": {
                        "entries_type": {
                          "Object": {
                            "properties": {
                              "href": {
                                "Optional": {
                                  "data_type": {
                                    "String": {}
                                  }
                                }
                              },
                              "rel": {
                                "Optional": {
                                  "data_type": {
                                    "String": {}
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "monthsUntilExpiration": {
                  "Optional": {
                    "data_type": {
                      "Integer": {}
                    }
                  }
                },
                "notAfter": {
                  "Optional": {
                    "data_type": {
                      "String": {}
                    }
                  }
                },
                "subject": {
                  "Optional": {
                    "data_type": {
                      "String": {
                        "validation": {
                          "Regex": {
                            "regex": "^(?:(?<cn>CN=(?<name>[^,]*)),)?(?:(?<path>(?:(?:CN|OU)=[^,]+,?)+),)?(?<domain>(?:DC=[^,]+,?)+)$"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "response_bodies": {
            "json": {
              "String": {}
            }
          }
        }
      }
    },
    "createGroupEncryptionAtRestPrivateEndpoint": {
