                  "Optional": {
                    "data_type": {
                      "String": {
                        "validation": {
                          "Regex": {
                            "regex": "^([a-f0-9]{24})$"
                          }
                        }
                      }
                    }
                  }
                },
                "destinationOrgPrivateApiKey": {
                  "Optional": {
                    "data_type": {
                      "String": {}
                    }
                  }
                },
                "destinationOrgPublicApiKey": {
                  "Optional": {
                    "data_type": {
                      "String": {
                        "validation": {
                          "Length": {
                            "min": 8,
                            "max": 8
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "response_bodies": {
            "json": {
              "Object": {
                "properties": {
                  "clusterCount": {
                    "Integer": {}
                  },
                  "created": {
                    "String": {}
                  },
                  "id": {
                    "Optional": {
                      "data_type": {
                        "String": {
                          "validation": {
                            "Regex": {
                              "regex": "^([a-f0-9]{24})$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "links": {
                    "Optional": {
                      "data_type": {
                        "Array": {
                          "entries_type": {
                            "Object": {
                              "properties": {
                                "href": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "rel": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "name": {
                    "String": {
                      "validation": {
                        "Regex": {
                          "regex": "^[\\p{L}\\p{N}\\-_.(),:&@+']{1,64}$"
                        }
                      }
                    }
                  },
                  "orgId": {
                    "String": {
                      "validation": {
                        "Regex": {
                          "regex": "^([a-f0-9]{24})$"
                        }
                      }
                    }
                  },
                  "regionUsageRestrictions": {
                    "Optional": {
                      "data_type": {
                        "Enum": [
