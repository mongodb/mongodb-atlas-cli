    "getGroupClusterSnapshot": {
      "description": "Returns one legacy backup snapshot for one cluster in the specified project. Effective 23 March 2020, all new clusters can use only Cloud Backups. When you upgrade to 4.2, your backup system upgrades to cloud backup if it is currently set to legacy backup. After this upgrade, all your existing legacy backup snapshots remain available. They expire over time in accordance with your retention policy. Your backup policy resets to the default schedule. If you had a custom backup policy in place with legacy backups, you must re-create it with the procedure outlined in the Cloud Backup documentation.",
      "operation_id": "getGroupClusterSnapshot",
      "operation_id_override": "getClusterSnapshot",
      "http_verb": "GET",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies your project. Use the [/groups](#tag/Projects/operation/listProjects) endpoint to retrieve all projects to which the authenticated user has access.\n\n**NOTE**: Groups and projects are synonymous terms. Your group id is the same as your project id. For existing groups, your group/project id remains the same. The resource and corresponding endpoints use the term groups.",
              "name": "groupId",
              "required": true
            }
          },
          {
            "Const": "clusters"
          },
          {
            "Parameter": {
              "description": "Human-readable label that identifies the cluster.",
              "name": "clusterName",
              "required": true
            }
          },
          {
            "Const": "snapshots"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies the desired snapshot.",
              "name": "snapshotId",
              "required": true
            }
          }
        ],
        "query_parameters": [
          {
            "description": "Flag that indicates whether Application wraps the response in an `envelope` JSON object. Some API clients cannot access the HTTP response headers or status code. To remediate this, set envelope=true in the query. Endpoints that return a list of results use the results object as an envelope. Application adds the status parameter to the response body.",
            "name": "envelope",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          }
        ]
      },
