    "listGroupClusterBackupCheckpoints": {
      "description": "Returns all legacy backup checkpoints for one cluster in the specified project.",
      "operation_id": "listGroupClusterBackupCheckpoints",
      "operation_id_override": "listClusterBackupCheckpoints",
      "http_verb": "GET",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
