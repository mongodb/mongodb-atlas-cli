    "updateGroupStreamConnectionFailoverConnection": {
      "description": "Update one failover connection of the specified stream workspace.",
      "operation_id": "updateGroupStreamConnectionFailoverConnection",
      "operation_id_override": "updateStreamFailoverConnection",
      "http_verb": "PATCH",
      "url": {
