    "updateGroupCustomDbRoleRole": {
      "description": "Updates one custom role in the specified project.",
      "operation_id": "updateGroupCustomDbRoleRole",
      "operation_id_override": "updateCustomDbRole",
      "http_verb": "PATCH",
      "url": {
        "parts": [
