    "listOrgInvites": {
      "description": "Returns all pending invitations to the specified organization. \n\n**Note**: Invitation management APIs are deprecated. Use Return All MongoDB Cloud Users in One Organization and filter by `orgMembershipStatus` to return all pending users.",
