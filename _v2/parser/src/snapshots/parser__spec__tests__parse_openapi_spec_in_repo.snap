                                          "hasAutoEmbedding": {
                                            "Optional": {
                                              "data_type": {
                                                "Boolean": {}
                                              }
                                            }
                                          },
                                          "hasIndexCoverage": {
                                            "Optional": {
                                              "data_type": {
                                                "Boolean": {}
                                              }
                                            }
                                          },
                                          "hasRerank": {
                                            "Optional": {
                                              "data_type": {
                                                "Boolean": {}
                                              }
                                            }
                                          },
                                          "hasSort": {
                                            "Optional": {
                                              "data_type": {
                                                "Boolean": {}
                                              }
                                            }
                                          },
                                          "keysExamined": {
                                            "Optional": {
                                              "data_type": {
                                                "Integer": {}
                                              }
                                            }
                                          },
