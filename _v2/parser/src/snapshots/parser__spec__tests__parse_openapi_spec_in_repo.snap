    "getGroupDataFederationLimit": {
      "description": "Returns the details of one query limit for the specified federated database instance in the specified project.",
      "operation_id": "getGroupDataFederationLimit",
      "operation_id_override": "getDataFederationLimit",
      "http_verb": "GET",
      "url": {
        "parts": [
          {
