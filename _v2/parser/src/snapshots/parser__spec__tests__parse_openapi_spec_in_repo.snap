    "listGroupInvites": {
      "description": "Returns all pending invitations to the specified project.",
      "operation_id": "listGroupInvites",
      "http_verb": "GET",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies your project. Use the [/groups](#tag/Projects/operation/listProjects) endpoint to retrieve all projects to which the authenticated user has access.\n\n**NOTE**: Groups and projects are synonymous terms. Your group id is the same as your project id. For existing groups, your group/project id remains the same. The resource and corresponding endpoints use the term groups.",
              "name": "groupId",
              "required": true
            }
          },
          {
            "Const": "invites"
          }
        ],
        "query_parameters": [
          {
            "description": "Flag that indicates whether Application wraps the response in an `envelope` JSON object. Some API clients cannot access the HTTP response headers or status code. To remediate this, set envelope=true in the query. Endpoints that return a list of results use the results object as an envelope. Application adds the status parameter to the response body.",
            "name": "envelope",
            "required": false
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          },
          {
            "description": "Email address of the user account invited to this project.",
            "name": "username",
            "required": false
          }
        ]
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2023-01-01": {
          "version": "2023-01-01",
          "response_bodies": {
            "json": {
              "Array": {
                "entries_type": {
                  "Object": {
                    "properties": {
                      "createdAt": {
                        "Optional": {
                          "data_type": {
                            "String": {}
                          }
                        }
                      },
                      "expiresAt": {
                        "Optional": {
                          "data_type": {
                            "String": {}
                          }
                        }
                      },
                      "groupId": {
                        "Optional": {
                          "data_type": {
                            "String": {
                              "validation": {
                                "Regex": {
                                  "regex": "^([a-f0-9]{24})$"
                                }
                              }
                            }
                          }
                        }
                      },
                      "groupName": {
                        "Optional": {
                          "data_type": {
                            "String": {
                              "validation": {
                                "Regex": {
                                  "regex": "^[\\p{L}\\p{N}\\-_.(),:&@+']{1,64}$"
                                }
                              }
                            }
                          }
                        }
                      },
                      "id": {
                        "Optional": {
                          "data_type": {
                            "String": {
                              "validation": {
                                "Regex": {
                                  "regex": "^([a-f0-9]{24})$"
                                }
                              }
                            }
                          }
                        }
                      },
                      "inviterUsername": {
                        "Optional": {
                          "data_type": {
                            "String": {}
                          }
                        }
                      },
                      "links": {
                        "Optional": {
                          "data_type": {
                            "Array": {
                              "entries_type": {
                                "Object": {
                                  "properties": {
                                    "href": {
                                      "Optional": {
                                        "data_type": {
                                          "String": {}
                                        }
                                      }
                                    },
                                    "rel": {
                                      "Optional": {
                                        "data_type": {
                                          "String": {}
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "roles": {
                        "Optional": {
                          "data_type": {
                            "Array": {
                              "entries_type": {
                                "String": {}
                              }
                            }
                          }
                        }
                      },
                      "username": {
                        "Optional": {
                          "data_type": {
                            "String": {}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
