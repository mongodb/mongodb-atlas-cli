    "updateOrgUser": {
      "description": "Updates one MongoDB Cloud user in the specified organization. You can update an active user or a user that has not yet accepted the invitation to join the organization. \n\n**Note**: Only include the fields you wish to update in the request body. Supplying a field with an empty value will reset that field on the user.\n\n**Note**: This resource cannot be used to update pending users invited via the deprecated Invite One MongoDB Cloud User to Join One Project endpoint.",
      "operation_id": "updateOrgUser",
      "http_verb": "PATCH",
