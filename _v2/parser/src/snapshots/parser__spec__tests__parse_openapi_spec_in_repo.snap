    "setGroupServerlessPerformanceAdvisorAutoIndexing": {
      "description": "Set whether the Serverless Auto Indexing feature is enabled. This endpoint sets a value for Flex clusters that were created with the Create Serverless Instance endpoint or Flex clusters that were migrated from Serverless instances. However, the value returned is not indicative of the Auto Indexing state as Auto Indexing is unavailable for Flex clusters. This endpoint will be sunset on January 22, 2026.",
      "operation_id": "setGroupServerlessPerformanceAdvisorAutoIndexing",
      "operation_id_override": "setServerlessAutoIndexing",
      "http_verb": "POST",
      "url": {
        "parts": [
          {
            "Const": "api"
          },
          {
            "Const": "atlas"
          },
          {
            "Const": "v2"
          },
          {
            "Const": "groups"
          },
          {
            "Parameter": {
              "description": "Unique 24-hexadecimal digit string that identifies your project. Use the [/groups](#tag/Projects/operation/listProjects) endpoint to retrieve all projects to which the authenticated user has access.\n\n**NOTE**: Groups and projects are synonymous terms. Your group id is the same as your project id. For existing groups, your group/project id remains the same. The resource and corresponding endpoints use the term groups.",
              "name": "groupId",
              "required": true
            }
          },
          {
            "Const": "serverless"
          },
          {
            "Parameter": {
              "description": "Human-readable label that identifies the cluster.",
              "name": "clusterName",
              "required": true
            }
          },
          {
            "Const": "performanceAdvisor"
          },
          {
            "Const": "autoIndexing"
          }
        ],
        "query_parameters": [
          {
            "description": "Value that we want to set for the Serverless Auto Indexing toggle.",
            "name": "enable",
            "required": true
          },
          {
            "description": "Flag that indicates whether the response body should be in the prettyprint format.",
            "name": "pretty",
            "required": false
          }
        ]
      },
      "headers": {
        "parameters": {}
      },
      "versions": {
        "2023-01-01": {
          "version": "2023-01-01",
          "response_bodies": {}
        }
