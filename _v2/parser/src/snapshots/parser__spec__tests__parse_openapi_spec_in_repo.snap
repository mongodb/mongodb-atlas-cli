                                            "Optional": {
                                              "data_type": {
                                                "Double": {}
                                              }
                                            }
                                          },
                                          "numYields": {
                                            "Optional": {
                                              "data_type": {
                                                "Integer": {}
                                              }
                                            }
                                          },
                                          "operationExecutionTime": {
                                            "Optional": {
                                              "data_type": {
                                                "Integer": {}
                                              }
                                            }
                                          },
                                          "responseLength": {
                                            "Optional": {
                                              "data_type": {
                                                "Integer": {}
                                              }
                                            }
                                          },
                                          "tokensUsed": {
                                            "Optional": {
                                              "data_type": {
                                                "Integer": {}
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                },
                                "namespace": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "opType": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "replicaState": {
