            "json": {
              "Object": {
                "properties": {
                  "links": {
                    "Optional": {
                      "data_type": {
                        "Array": {
                          "entries_type": {
                            "Object": {
                              "properties": {
                                "href": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                },
                                "rel": {
                                  "Optional": {
                                    "data_type": {
                                      "String": {}
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "results": {
                    "Array": {
                      "entries_type": {
                        "Object": {
                          "properties": {
                            "databaseName": {
                              "Optional": {
                                "data_type": {
                                  "String": {}
                                }
                              }
                            },
                            "links": {
                              "Optional": {
                                "data_type": {
                                  "Array": {
