                                      "operations": {
                                        "Optional": {
                                          "data_type": {
                                            "Array": {
                                              "entries_type": {
                                                "Object": {
                                                  "properties": {
                                                    "predicates": {
                                                      "Optional": {
                                                        "data_type": {
                                                          "Array": {
                                                            "entries_type": {
                                                              "Object": {
                                                                "properties": {}
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    },
                                                    "stats": {
                                                      "Optional": {
                                                        "data_type": {
                                                          "Object": {
                                                            "properties": {
                                                              "ms": {
                                                                "Optional": {
                                                                  "data_type": {
                                                                    "Integer": {}
                                                                  }
                                                                }
                                                              },
                                                              "nReturned": {
                                                                "Optional": {
